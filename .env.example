# Copy this file to .env and fill in your key. .env stays on your computer.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: coaching effort, "medium" (default) or "low". Nothing higher is allowed.
# PALADIN_COACH_EFFORT=medium

# Optional: maximum coaching questions per day (default 40).
# COACH_DAILY_LIMIT=40

# Optional: port (default 5173) and data folder (default ./data).
# PORT=5173
# PALADIN_DATA_DIR=data
